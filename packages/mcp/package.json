{
  "name": "@open-merchant/mcp",
  "version": "1.0.0-alpha.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Read-only, stdio-only MCP server exposing one Open Merchant project folder as resources.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "open-merchant-mcp": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/cli.js --external:zod --external:@modelcontextprotocol/server"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@open-merchant/core": "workspace:*",
    "@open-merchant/shared": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
