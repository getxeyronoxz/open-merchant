{
  "name": "open-merchant",
  "private": true,
  "version": "1.0.0-alpha.4",
  "license": "AGPL-3.0-only",
  "description": "Local-first, AI-native commerce research workbench.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @open-merchant/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test",
    "test:e2e": "pnpm --filter @open-merchant/desktop test:e2e",
    "test:all": "pnpm -r test && pnpm --filter @open-merchant/desktop test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:all"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
