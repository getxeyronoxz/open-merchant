# Dependencies
node_modules/

# Build output
dist/
out/
coverage/
target/
src-tauri/target/

# Electron / packaging
release/
# A one-off packaged build used to verify a launcher without disturbing an
# existing release/ tree (a locked app.asar makes electron-builder fail).
apps/desktop/release-verify/

# The MCP server is staged into the bundle by apps/desktop/stage-mcp.cjs at
# build time. The source of truth is packages/mcp; this copy is build output.
apps/desktop/resources/mcp/

# Environment
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db

# Legacy worktrees (to be removed in Phase 1e)
.worktrees/

# Developer signing material (never commit)
*.pfx
*.pass
# Code-graph analysis output (local tooling only)
graphify-out/

# demo recorder frames
.om-frames/

# Local agent scratch output (logs, run artifacts — never commit)
.agent/

# Launch and social copy is the owner's, not the project's. Drafts of it are
# written for them to post, and are not committed -- they are posts, not
# documentation.
docs/marketing/release-*

# Local Claude Code settings (per-machine)
.claude/settings.local.json
.superpowers/
